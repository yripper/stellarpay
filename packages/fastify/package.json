{
  "name": "@stellarpay-sdk/fastify",
  "version": "0.1.0",
  "description": "One-line Fastify plugin adapter for the Stellarpay payment paywall.",
  "keywords": ["stellar", "x402", "mpp", "payments", "paywall", "fastify", "plugin"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yripper/stellarpay.git", "directory": "packages/fastify" },
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellarpay-sdk/core": "workspace:*"
  },
  "peerDependencies": {
    "fastify": ">=4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fastify": "^4"
  }
}
