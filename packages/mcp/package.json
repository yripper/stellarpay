{
  "name": "@stellarpay/mcp",
  "version": "0.1.0",
  "description": "Per-tool-call payments for MCP servers via Stellar MPP, plus a paying MCP client wrapper.",
  "keywords": ["stellar", "x402", "mpp", "payments", "paywall", "mcp", "model-context-protocol"],
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/mpp": "^0.7.1",
    "@stellar/stellar-sdk": "16.2.0",
    "@stellarpay/core": "workspace:*",
    "mppx": "0.6.31"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
