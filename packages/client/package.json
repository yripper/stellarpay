{
  "name": "@stellarpay/client",
  "version": "0.1.0",
  "description": "Auto-paying fetch for Stellar x402 and MPP challenges, with spend limits.",
  "keywords": ["stellar", "x402", "mpp", "payments", "paywall", "fetch", "agent"],
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/mpp": "^0.7.1",
    "@stellar/stellar-sdk": "16.2.0",
    "@stellarpay/core": "workspace:*",
    "@x402/core": "~2.20.0",
    "@x402/fetch": "^2.20.0",
    "@x402/stellar": "^2.20.0",
    "mppx": "0.6.31"
  }
}
