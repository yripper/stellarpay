{
  "name": "@stellarpay/express",
  "version": "0.1.0",
  "description": "One-line Express middleware adapter for the Stellarpay payment paywall.",
  "keywords": ["stellar", "x402", "mpp", "payments", "paywall", "express", "middleware"],
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellarpay/core": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "devDependencies": {
    "@types/express": "^4",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6",
    "express": "^4",
    "supertest": "^6"
  }
}
