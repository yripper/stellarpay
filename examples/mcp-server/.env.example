# Seller/recipient public key (G...). Public value — safe to share.
DEMO_PAYTO=G...
# HMAC secret binding the per-tool MPP challenges (any random string; server-side only).
DEMO_MPP_SECRET=change-me
# Dashboard receipt reporting (both optional — unset disables reporting, the tools still work).
DASHBOARD_URL=
INGEST_SECRET=
PORT=4604
