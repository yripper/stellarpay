# Shared secret authorizing /ingest POSTs and outbound /unleash → agent /run calls.
INGEST_SECRET=change-me
# Public base URL of the agent service (no trailing slash). Unset → /unleash returns 503.
AGENT_URL=
# Port to bind (Railway injects PORT; local default 4600).
PORT=4600
# Seller account (G...) that receives payments. Optional — public value, same var name the
# seller services use. Unset → the "verify on-chain" link is hidden entirely.
DEMO_PAYTO=
# Buyer account (G...) the agent spends from. Optional — public value (already visible as
# `payer` in every x402 receipt). Unset → the live Horizon balance panel is hidden entirely.
DEMO_BUYER_PUBLIC=
