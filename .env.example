# Buyer identity — must hold testnet XLM (friendbot) and testnet USDC (trustline + faucet)
SMOKE_BUYER_SECRET=S...
# Seller/recipient public key
SMOKE_PAYTO=G...
# Server-side secrets
SMOKE_MPP_SECRET=change-me
# Optional: sponsor account secret for mpp sponsored-gas leg
SMOKE_SPONSOR_SECRET=
# Optional: x402 facilitator bearer token (OZ testnet facilitator requires this on
# /verify, /settle, /supported — without it those calls 401). If unset, smoke.ts
# auto-generates one at startup from the facilitator's own free, unauthenticated endpoint:
#   curl https://channels.openzeppelin.com/testnet/gen
SMOKE_FACILITATOR_KEY=
